# ============================================================
# FifeLite — variables d'environnement
# Copiez ce fichier vers .env et renseignez les valeurs.
# Ne commitez jamais .env ni de clés de service.
# ============================================================

# Application
NODE_ENV=development
APP_NAME=Fideto
PORT=3000

# Inscription commerçant : beta_form (formulaire + code) ou open (connexion directe depuis /tarifs)
MERCHANT_SIGNUP_MODE=beta_form
# Secrets du code à 6 chiffres et du cookie post-validation (production : chaînes aléatoires longues)
MERCHANT_SIGNUP_CODE_PEPPER=changez-moi-inscription-code-pepper
MERCHANT_SIGNUP_GRANT_SECRET=changez-moi-inscription-grant-secret
MERCHANT_SIGNUP_CODE_DAYS=14
MERCHANT_SIGNUP_GRANT_HOURS=72

# URL publique de l'application (utilisée aussi en Docker)
APP_URL=http://localhost:3000

# Origines autorisées (CSRF / CORS interne)
CUSTOMER_ORIGIN=https://fideto.fr
APP_ORIGIN=https://app.fideto.fr
ADMIN_ORIGIN=https://admin.fideto.fr
EMPLOYEE_ORIGIN=https://employe.fideto.fr
# Origines locales supplémentaires, séparées par des virgules
EXTRA_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Hôtes (sans schéma) pour le routage des sous-domaines
CUSTOMER_HOST=fideto.fr
APP_HOST=app.fideto.fr
ADMIN_HOST=admin.fideto.fr
EMPLOYEE_HOST=employe.fideto.fr

# Anciens domaines : alias acceptés pendant la transition (valeur vide = désactivé).
# LEGACY_REDIRECT_ENABLED=true SEULEMENT après vérification du nouveau domaine : les pages
# des anciens hôtes redirigent alors (308) vers les nouveaux ; /api n'est jamais redirigé.
LEGACY_CUSTOMER_HOST=fidelite.sitereadyshd.fr
LEGACY_APP_HOST=app-fidelite.sitereadyshd.fr
LEGACY_ADMIN_HOST=admin-fidelite.sitereadyshd.fr
LEGACY_EMPLOYEE_HOST=employe-fidelite.sitereadyshd.fr
LEGACY_REDIRECT_ENABLED=false

# Base de données PostgreSQL
DATABASE_URL=postgresql://fifelite:fifelite@localhost:5432/fifelite?schema=public

# Secret de signature des jetons QR (minimum 32 caractères aléatoires)
QR_SECRET=changez-moi-par-une-chaine-aleatoire-de-32-caracteres-min

# Durée de vie du QR client en secondes
QR_TTL_SECONDS=60

# Durée de vie de la session client / staff en jours
SESSION_DAYS=30

# Connexion avec Google (optionnel)
# Créez un client OAuth Web dans Google Cloud. Si ces valeurs restent vides,
# Fideto masque le bouton Google et conserve la connexion actuelle.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Cookie de session
SESSION_COOKIE_NAME=fifelite_session
EMPLOYEE_SESSION_COOKIE_NAME=fifelite_employee_session

# Super-administration (chemin secret + session dédiée)
# Exemple d'URL : http://localhost:3000/<SUPER_ADMIN_PATH>
SUPER_ADMIN_PATH=fife-super-admin-changez-moi-avec-une-valeur-longue-et-aleatoire
SUPER_ADMIN_SESSION_COOKIE=fifelite_super_admin_session
SUPER_ADMIN_SESSION_HOURS=8
# Liste blanche d'e-mails autorisés (séparés par des virgules). Vide = tous les SUPER_ADMIN.
SUPER_ADMIN_ALLOWED_EMAILS=

# Stockage persistant des uploads (fonds de cartes).
# Dev : laisser vide → data/uploads/ à la racine du projet (ignoré par Git).
# Prod VPS : bind mount /opt/fifelite/data/uploads → conteneur /var/lib/fifelite/uploads
# UPLOADS_DIR=/var/lib/fifelite/uploads

# Création du premier super-admin (script scripts/create-super-admin.ts)
SUPER_ADMIN_EMAIL=superadmin@fifelite.local
SUPER_ADMIN_PASSWORD=ChangeMe!SuperAdmin12
SUPER_ADMIN_FIRST_NAME=Super
SUPER_ADMIN_LAST_NAME=Admin
EMPLOYEE_INVITATION_HOURS=48
# Alias explicite pour les liens d'invitation employé (fallback : EMPLOYEE_ORIGIN)
EMPLOYEE_APP_URL=https://employe.fideto.fr

# ------------------------------------------------------------
# E-mail (invitations employés)
# Configurez Resend OU SMTP. Sans configuration, les invitations
# ne partent pas et l'administration affiche une erreur explicite.
# ------------------------------------------------------------
# Réception des messages /contact (Google Wallet « Customer support URL »).
SUPPORT_EMAIL=support@fideto.fr
MAIL_FROM=Fideto <noreply@fideto.fr>
RESEND_API_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

# Durée legacy en jours (ignorée si EMPLOYEE_INVITATION_HOURS est défini)
EMPLOYEE_INVITATION_DAYS=7

# Mode démo public (désactiver en production réelle avec PUBLIC_DEMO_MODE=false)
PUBLIC_DEMO_MODE=true

# QA magic login temporaire, désactivé par défaut.
# Activer uniquement pendant une campagne QA contrôlée, puis remettre false et redémarrer le conteneur web.
QA_MAGIC_LOGIN_ENABLED=false
QA_MERCHANT_USER_ID=
QA_EMPLOYEE_ID=
# Client test : cible de l'aperçu Google Wallet super-admin (carte globale Fideto, 30 min).
QA_CUSTOMER_USER_ID=
QA_MAGIC_LOGIN_ORIGIN=https://fideto.fr

# Seed de développement uniquement
# En production, le seed refuse de s'exécuter sauf si SEED_ALLOW_PRODUCTION=true
SEED_SUPERADMIN_EMAIL=superadmin@fifelite.local
SEED_SUPERADMIN_PASSWORD=ChangeMe!SuperAdmin1
SEED_MERCHANT_ADMIN_EMAIL=admin@cafe-demo.local
SEED_MERCHANT_ADMIN_PASSWORD=ChangeMe!Merchant1
SEED_EMPLOYEE_EMAIL=employe@cafe-demo.local
SEED_EMPLOYEE_PASSWORD=ChangeMe!Employee1
SEED_EMPLOYEE2_EMAIL=sam@cafe-demo.local
SEED_EMPLOYEE2_PASSWORD=ChangeMe!Employee2
SEED_EMPLOYEE3_EMAIL=noa@cafe-demo.local
SEED_EMPLOYEE3_PASSWORD=ChangeMe!Employee3
SEED_CUSTOMER_EMAIL=client@demo.local
SEED_CUSTOMER_PASSWORD=ChangeMe!Customer1
SEED_ALLOW_PRODUCTION=false

# ------------------------------------------------------------
# Google Wallet (optionnel)
# Si GOOGLE_WALLET_ENABLED=false, la PWA fonctionne sans Wallet.
# Ne jamais committer le fichier de clé JSON.
# Après approbation Issuer (publication) : conserver le même Issuer ID,
# le même compte de service et les mêmes class/object IDs.
# Pas de GOOGLE_WALLET_MODE — STRIPE_MODE reste indépendant.
# Diagnostic API : npm run diagnose:wallet-publication
# ------------------------------------------------------------
GOOGLE_WALLET_ENABLED=false
GOOGLE_WALLET_ISSUER_ID=3388000000023198536
GOOGLE_WALLET_GLOBAL_CLASS_ID=3388000000023198536.3388000000023198536.fifelife_global
GOOGLE_WALLET_SERVICE_ACCOUNT_EMAIL=fife-life-google-wallet@fide-life-wallet.iam.gserviceaccount.com
GOOGLE_WALLET_SERVICE_ACCOUNT_FILE=/run/secrets/google-wallet-service-account.json
GOOGLE_WALLET_ORIGIN=https://fideto.fr

# ------------------------------------------------------------
# Stripe (campagnes payantes — Partie 9)
# Sans ces deux valeurs : les campagnes gratuites (couvertes par le quota inclus)
# continuent de fonctionner normalement ; tout achat affiche une erreur de
# configuration claire (503 STRIPE_NOT_CONFIGURED) au lieu de planter l'application.
# ------------------------------------------------------------
# Mode actif : "test" ou "live" (défaut : test). Lu au démarrage par web ET worker :
# changer de mode = modifier cette ligne puis recréer les conteneurs (pas de rebuild).
# Valeur invalide = aucun paiement possible (jamais de retombée silencieuse sur le réel).
STRIPE_MODE=test
# Clés et secrets webhook SÉPARÉS par mode. Seule la clé du mode actif crée des paiements ;
# une clé sk_live_ dans une variable TEST (ou l'inverse) est refusée.
STRIPE_TEST_SECRET_KEY=
STRIPE_TEST_WEBHOOK_SECRET=
STRIPE_LIVE_SECRET_KEY=
STRIPE_LIVE_WEBHOOK_SECRET=
# Mode test uniquement : ids (séparés par des virgules) des commerces autorisés à payer "fictivement".
# Les autres commerces gardent leurs quotas gratuits mais ne peuvent ni recharger ni acheter en test.
STRIPE_TEST_MERCHANT_IDS=
# ⚠️ NE PAS PASSER EN STRIPE_MODE=live avant d'avoir corrigé ou défini une procédure manuelle pour :
# un remboursement d'une RECHARGE de solde marketing fait depuis le Dashboard Stripe ne retire
# actuellement pas le crédit correspondant (voir handleChargeRefunded dans
# src/app/api/stripe/webhook/route.ts). Sans correction, un remboursement de recharge doit être
# suivi d'un ajustement manuel du solde marketing du commerce concerné.

# ------------------------------------------------------------
# Web Push (Partie 11)
# Générez une paire de clés VAPID avec : npx web-push generate-vapid-keys
# Sans ces valeurs, le bouton "Activer les notifications" reste inactif et
# l'application retombe sur le centre de notifications interne uniquement.
# ------------------------------------------------------------
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:contact@fideto.fr

# Secret de signature des liens de désinscription e-mail (minimum 32 caractères aléatoires)
UNSUBSCRIBE_SECRET=changez-moi-par-une-chaine-aleatoire-de-32-caracteres-min

# ------------------------------------------------------------
# Worker de campagnes (Partie 15) — voir deploy/docker-compose.yml (service "worker")
# ------------------------------------------------------------
CAMPAIGN_WORKER_BATCH_SIZE=50
CAMPAIGN_WORKER_INTERVAL_MS=15000
