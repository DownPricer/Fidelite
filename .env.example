# ============================================================
# FifeLite — variables d'environnement
# Copiez ce fichier vers .env et renseignez les valeurs.
# Ne commitez jamais .env ni de clés de service.
# ============================================================

# Application
NODE_ENV=development
APP_NAME=FifeLite
PORT=3000

# URL publique de l'application (utilisée aussi en Docker)
APP_URL=http://localhost:3000

# Origines autorisées (CSRF / CORS interne)
CUSTOMER_ORIGIN=https://fidelite.sitereadyshd.fr
APP_ORIGIN=https://app-fidelite.sitereadyshd.fr
ADMIN_ORIGIN=https://admin-fidelite.sitereadyshd.fr
EMPLOYEE_ORIGIN=https://employe-fidelite.sitereadyshd.fr
# Origines locales supplémentaires, séparées par des virgules
EXTRA_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Hôtes (sans schéma) pour le routage des sous-domaines
CUSTOMER_HOST=fidelite.sitereadyshd.fr
APP_HOST=app-fidelite.sitereadyshd.fr
ADMIN_HOST=admin-fidelite.sitereadyshd.fr
EMPLOYEE_HOST=employe-fidelite.sitereadyshd.fr

# Base de données PostgreSQL
DATABASE_URL=postgresql://fifelite:fifelite@localhost:5432/fifelite?schema=public

# Secret de signature des jetons QR (minimum 32 caractères aléatoires)
QR_SECRET=changez-moi-par-une-chaine-aleatoire-de-32-caracteres-min

# Durée de vie du QR client en secondes
QR_TTL_SECONDS=60

# Durée de vie de la session client / staff en jours
SESSION_DAYS=30

# Cookie de session
SESSION_COOKIE_NAME=fifelite_session
EMPLOYEE_SESSION_COOKIE_NAME=fifelite_employee_session

# Super-administration (chemin secret + session dédiée)
# Exemple d'URL : http://localhost:3000/<SUPER_ADMIN_PATH>
SUPER_ADMIN_PATH=fife-super-admin-changez-moi-avec-une-valeur-longue-et-aleatoire
SUPER_ADMIN_SESSION_COOKIE=fifelite_super_admin_session
SUPER_ADMIN_SESSION_HOURS=8
# Liste blanche d'e-mails autorisés (séparés par des virgules). Vide = tous les SUPER_ADMIN.
SUPER_ADMIN_ALLOWED_EMAILS=

# Stockage persistant des uploads (fonds de cartes).
# Dev : laisser vide → data/uploads/ à la racine du projet (ignoré par Git).
# Prod VPS : bind mount /opt/fifelite/data/uploads → conteneur /var/lib/fifelite/uploads
# UPLOADS_DIR=/var/lib/fifelite/uploads

# Création du premier super-admin (script scripts/create-super-admin.ts)
SUPER_ADMIN_EMAIL=superadmin@fifelite.local
SUPER_ADMIN_PASSWORD=ChangeMe!SuperAdmin12
SUPER_ADMIN_FIRST_NAME=Super
SUPER_ADMIN_LAST_NAME=Admin
EMPLOYEE_INVITATION_HOURS=48
# Alias explicite pour les liens d'invitation employé (fallback : EMPLOYEE_ORIGIN)
EMPLOYEE_APP_URL=https://employe-fidelite.sitereadyshd.fr

# ------------------------------------------------------------
# E-mail (invitations employés)
# Configurez Resend OU SMTP. Sans configuration, les invitations
# ne partent pas et l'administration affiche une erreur explicite.
# ------------------------------------------------------------
MAIL_FROM=Fife Life <invitations@votredomaine.fr>
RESEND_API_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

# Durée legacy en jours (ignorée si EMPLOYEE_INVITATION_HOURS est défini)
EMPLOYEE_INVITATION_DAYS=7

# Mode démo public (désactiver en production réelle avec PUBLIC_DEMO_MODE=false)
PUBLIC_DEMO_MODE=true

# Seed de développement uniquement
# En production, le seed refuse de s'exécuter sauf si SEED_ALLOW_PRODUCTION=true
SEED_SUPERADMIN_EMAIL=superadmin@fifelite.local
SEED_SUPERADMIN_PASSWORD=ChangeMe!SuperAdmin1
SEED_MERCHANT_ADMIN_EMAIL=admin@cafe-demo.local
SEED_MERCHANT_ADMIN_PASSWORD=ChangeMe!Merchant1
SEED_EMPLOYEE_EMAIL=employe@cafe-demo.local
SEED_EMPLOYEE_PASSWORD=ChangeMe!Employee1
SEED_EMPLOYEE2_EMAIL=sam@cafe-demo.local
SEED_EMPLOYEE2_PASSWORD=ChangeMe!Employee2
SEED_EMPLOYEE3_EMAIL=noa@cafe-demo.local
SEED_EMPLOYEE3_PASSWORD=ChangeMe!Employee3
SEED_CUSTOMER_EMAIL=client@demo.local
SEED_CUSTOMER_PASSWORD=ChangeMe!Customer1
SEED_ALLOW_PRODUCTION=false

# ------------------------------------------------------------
# Google Wallet (optionnel)
# Si GOOGLE_WALLET_ENABLED=false, la PWA fonctionne sans Wallet.
# Ne jamais committer le fichier de clé JSON.
# ------------------------------------------------------------
GOOGLE_WALLET_ENABLED=false
GOOGLE_WALLET_ISSUER_ID=3388000000023198536
GOOGLE_WALLET_GLOBAL_CLASS_ID=3388000000023198536.fifelife_global
GOOGLE_WALLET_SERVICE_ACCOUNT_EMAIL=fife-life-google-wallet@fide-life-wallet.iam.gserviceaccount.com
GOOGLE_WALLET_SERVICE_ACCOUNT_FILE=/run/secrets/google-wallet-service-account.json
GOOGLE_WALLET_ORIGIN=https://fidelite.sitereadyshd.fr
