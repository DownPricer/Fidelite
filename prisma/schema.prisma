generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum PlatformRole {
  SUPER_ADMIN
  CUSTOMER
}

enum MerchantRole {
  MERCHANT_ADMIN
  EMPLOYEE
}

enum LoyaltyTxType {
  EARN_VISIT
  REDEEM_REWARD
  ADJUSTMENT
  CANCEL
}

enum LoyaltyMode {
  VISITS
  POINTS_BY_AMOUNT
  FIXED_POINTS
  AMOUNT_TIERS
}

enum ProgramStatus {
  DRAFT
  ACTIVE
  ARCHIVED
  SCHEDULED
}

enum StaffPreset {
  MANAGER
  CASHIER
  CUSTOM
}

enum InvitationStatus {
  NONE
  PENDING
  ACCEPTED
  CANCELLED
}

enum SessionKind {
  STANDARD
  EMPLOYEE
  SUPER_ADMIN
}

enum QaLoginRole {
  merchant
  employee
  customer
}

enum MerchantStatus {
  DRAFT
  TRIAL
  ACTIVE
  SUSPENDED
  ARCHIVED
}

enum CardTemplateStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum MerchantCardSlot {
  GENERAL
  VISITS
  POINTS_BY_AMOUNT
  FIXED_POINTS
  AMOUNT_TIERS
}

enum SubscriptionPlan {
  STARTER
  PRO
  ENTERPRISE
}

enum SubscriptionStatus {
  DRAFT
  TRIAL
  ACTIVE
  PAST_DUE
  CANCELLED
  EXPIRED
}

enum SubscriptionFrequency {
  MONTHLY
  YEARLY
}

enum ContractStatus {
  DRAFT
  ACTIVE
  EXPIRED
  TERMINATED
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

enum RewardType {
  FREE_PRODUCT
  FREE_SERVICE
  PERCENT_DISCOUNT
  FIXED_DISCOUNT
  GIFT
  UPGRADE
  CUSTOM
}

enum LoyaltyTxStatus {
  COMPLETED
  PENDING
  CANCELLED
  CORRECTED
}

enum AccountDeletionStatus {
  PENDING
  PROCESSED
}

enum WalletEventType {
  CARD_CREATED
  CARD_UNLOCKED
  CARD_REMOVED
  MERCHANT_CARD_UPDATED
  MERCHANT_POINTS_UPDATED
  REWARD_REDEEMED
  FIFE_LIFE_POINTS_UPDATED
}

enum GoogleWalletClassKind {
  GLOBAL
  MERCHANT
}

enum GoogleWalletSyncStatus {
  NEVER_SYNCED
  PENDING
  SYNCED
  ERROR
  DISABLED
}

enum CustomerRewardEntitlementStatus {
  AVAILABLE
  REDEEMED
  EXPIRED
  INELIGIBLE
}

model User {
  id                 String       @id @default(cuid())
  email              String       @unique
  passwordHash       String
  firstName          String
  lastName           String?
  displayName        String?
  avatarUrl          String?
  phone              String?
  phoneCountryCode   String?      @default("+33")
  phoneVerified      Boolean      @default(false)
  pendingEmail       String?
  addressLine1       String?
  addressLine2       String?
  postalCode         String?
  city               String?
  country            String?      @default("FR")
  platformRole       PlatformRole @default(CUSTOMER)
  isActive           Boolean      @default(true)
  mustChangePassword Boolean      @default(false)
  privacyConsentAt   DateTime?
  /// Solde global de points Fidelo (tous commerces confondus).
  fifeLifePoints     Int          @default(0)
  /// Numéro client court affiché sur la carte et saisissable en caisse.
  clientNumber       String?      @unique
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  sessions              Session[]
  oauthAccounts         OAuthAccount[]
  merchantMemberships   MerchantMembership[]
  customerMemberships   CustomerMembership[]
  performedTransactions LoyaltyTransaction[]     @relation("PerformedBy")
  auditLogs             AuditLog[]
  deletionRequests      AccountDeletionRequest[]
  fifeLifeLedger        FifeLifePointsLedger[]
  walletEvents          WalletEvent[]
  fifeLifeQrToken       FifeLifeQrToken?
  preferences           CustomerPreferences?
  googleWalletObjects   GoogleWalletObject[]
  notifications         InAppNotification[]
  pushSubscriptions     PushSubscription[]
  consentEvents         ConsentEvent[]
}

model OAuthAccount {
  id                String   @id @default(cuid())
  userId            String
  provider          String
  providerAccountId String
  email             String?
  emailVerified     Boolean  @default(false)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
  @@index([provider, email])
}

model CustomerPreferences {
  id                        String    @id @default(cuid())
  userId                    String    @unique
  notifyPointsMovements     Boolean   @default(true)
  notifyNewBenefit          Boolean   @default(true)
  notifyBenefitExpiring     Boolean   @default(true)
  notifyNewCard             Boolean   @default(true)
  /// Offres in-app des commerces dont le client possède la carte (Partie 6).
  notifyMerchantOffers      Boolean   @default(false)
  /// Bons plans locaux Fidelo (réseau) in-app (Partie 6).
  notifyFifeLifeNews        Boolean   @default(false)
  notifySecurity            Boolean   @default(true)
  /// Réglages globaux existants (service/sécurité). Les cases de prospection ci-dessous
  /// sont volontairement séparées par canal ET par source (Partie 6 — aucune case précochée).
  notifyChannelPush         Boolean   @default(true)
  notifyChannelEmail        Boolean   @default(true)
  notifyChannelSms          Boolean   @default(false)
  /// Push des commerces dont le client possède la carte.
  adsMerchantPush           Boolean   @default(false)
  /// E-mails des commerces dont le client possède la carte.
  adsMerchantEmail          Boolean   @default(false)
  /// Push des bons plans locaux Fidelo (réseau).
  adsNetworkPush            Boolean   @default(false)
  /// E-mails des bons plans locaux Fidelo (réseau).
  adsNetworkEmail           Boolean   @default(false)
  /// Zone marketing facultative (ville/code postal déclaratifs — jamais de géolocalisation
  /// précise en arrière-plan), utilisée uniquement pour les bons plans locaux Fidelo.
  marketingZoneCity         String?
  marketingZonePostalCode   String?
  /// Version de la politique de consentement au moment de la dernière modification (audit : voir ConsentEvent).
  consentVersion            String?
  consentUpdatedAt          DateTime?
  consentPersonalizedOffers Boolean   @default(false)
  consentMarketing          Boolean   @default(false)
  consentAnalytics          Boolean   @default(false)
  language                  String    @default("fr")
  updatedAt                 DateTime  @updatedAt
  user                      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Session {
  id                   String              @id @default(cuid())
  userId               String
  tokenHash            String              @unique
  kind                 SessionKind         @default(STANDARD)
  merchantMembershipId String?
  isQaMagicLogin       Boolean             @default(false)
  qaMagicLoginTokenId  String?
  expiresAt            DateTime
  userAgent            String?
  ip                   String?
  createdAt            DateTime            @default(now())
  user                 User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  merchantMembership   MerchantMembership? @relation(fields: [merchantMembershipId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@index([merchantMembershipId])
  @@index([isQaMagicLogin])
  @@index([qaMagicLoginTokenId])
}

model QaMagicLoginToken {
  id        String      @id @default(cuid())
  tokenHash String      @unique
  role      QaLoginRole
  subjectId String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime    @default(now())

  @@index([role, subjectId])
  @@index([expiresAt])
  @@index([usedAt])
}

model Merchant {
  id                  String         @id @default(cuid())
  name                String
  slug                String         @unique
  logoUrl             String?
  coverUrl            String?
  primaryColor        String         @default("#0F766E")
  isActive            Boolean        @default(true)
  status              MerchantStatus @default(ACTIVE)
  category            String?
  shortDescription    String?
  description         String?
  website             String?
  socialLinks         Json?
  publicPhone         String?
  publicEmail         String?
  legalName           String?
  ownerName           String?
  ownerPhone          String?
  adminEmail          String?
  addressLine1        String?
  addressLine2        String?
  postalCode          String?
  city                String?
  country             String?        @default("FR")
  siret               String?
  vatNumber           String?
  billingAddressLine1 String?
  billingAddressLine2 String?
  billingPostalCode   String?
  billingCity         String?
  billingCountry      String?
  timezone            String         @default("Europe/Paris")
  openingHours        Json?
  closedDays          Json?
  exceptionalClosures Json?
  visibleInSearch     Boolean        @default(true)
  slugLocked          Boolean        @default(false)
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt

  program             LoyaltyProgram?
  memberships         MerchantMembership[]
  marketingBalance    MarketingBalance?
  marketingLedger     MarketingLedgerEntry[]
  customerMemberships CustomerMembership[]
  transactions        LoyaltyTransaction[]
  auditLogs           AuditLog[]
  qrTokens            QrToken[]
  caisseGrants        CaisseGrant[]
  walletEvents        WalletEvent[]
  cardTemplates       MerchantCardTemplate[]
  rewardEntitlements  CustomerRewardEntitlement[]
  subscription        MerchantSubscription?
  contracts           MerchantContract[]
  payments            MerchantPayment[]
  googleWalletClasses GoogleWalletClass[]
  googleWalletObjects GoogleWalletObject[]
  campaigns           Campaign[]
  adRequests          AdRequest[]
}

model MerchantMembership {
  id                   String               @id @default(cuid())
  userId               String
  merchantId           String
  role                 MerchantRole
  staffPreset          StaffPreset          @default(CASHIER)
  permissions          Json?
  invitationStatus     InvitationStatus     @default(NONE)
  invitationTokenHash  String?              @unique
  invitationExpiresAt  DateTime?
  invitationAcceptedAt DateTime?
  inviteMessage        String?
  invitedAt            DateTime?
  lastActivityAt       DateTime?
  isActive             Boolean              @default(true)
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt
  user                 User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  merchant             Merchant             @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  employeeSessions     Session[]
  invitations          EmployeeInvitation[]

  @@unique([userId, merchantId])
  @@index([merchantId, role, isActive])
}

model EmployeeInvitation {
  id           String             @id @default(cuid())
  membershipId String
  tokenHash    String             @unique
  createdAt    DateTime           @default(now())
  expiresAt    DateTime
  usedAt       DateTime?
  revokedAt    DateTime?
  membership   MerchantMembership @relation(fields: [membershipId], references: [id], onDelete: Cascade)

  @@index([membershipId, createdAt])
}

model LoyaltyProgram {
  id             String                  @id @default(cuid())
  merchantId     String                  @unique
  mode           LoyaltyMode             @default(VISITS)
  status         ProgramStatus           @default(ACTIVE)
  visitsRequired Int                     @default(10)
  rewardLabel    String
  config         Json                    @default("{}")
  draftConfig    Json?
  version        Int                     @default(1)
  publishedAt    DateTime?
  scheduledAt    DateTime?
  merchant       Merchant                @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  rewards        LoyaltyReward[]
  versions       LoyaltyProgramVersion[]
  updatedAt      DateTime                @updatedAt
  createdAt      DateTime                @default(now())
}

model LoyaltyReward {
  id                 String                      @id @default(cuid())
  programId          String
  name               String
  description        String?
  iconUrl            String?
  rewardType         RewardType                  @default(CUSTOM)
  threshold          Int
  thresholdUnit      String                      @default("visits")
  value              Float?
  minPurchase        Float?
  maxDiscount        Float?
  isActive           Boolean                     @default(true)
  sortOrder          Int                         @default(0)
  validFrom          DateTime?
  validUntil         DateTime?
  maxUsesPerCustomer Int?
  reuseDelayDays     Int?
  globalLimit        Int?
  conditions         Json?
  archivedAt         DateTime?
  program            LoyaltyProgram              @relation(fields: [programId], references: [id], onDelete: Cascade)
  transactions       LoyaltyTransaction[]
  entitlements       CustomerRewardEntitlement[]
  createdAt          DateTime                    @default(now())
  updatedAt          DateTime                    @updatedAt

  @@index([programId, sortOrder])
  @@index([programId, archivedAt])
}

model LoyaltyProgramVersion {
  id          String         @id @default(cuid())
  programId   String
  version     Int
  mode        LoyaltyMode
  config      Json
  rewards     Json
  publishedAt DateTime       @default(now())
  publishedBy String?
  program     LoyaltyProgram @relation(fields: [programId], references: [id], onDelete: Cascade)

  @@index([programId, version])
}

model CustomerMembership {
  id                   String                      @id @default(cuid())
  userId               String
  merchantId           String
  pointsBalance        Int                         @default(0)
  visitsBalance        Int                         @default(0)
  points               Int                         @default(0)
  googleWalletObjectId String?
  googleWalletClassId  String?
  createdAt            DateTime                    @default(now())
  updatedAt            DateTime                    @updatedAt
  removedAt            DateTime?
  user                 User                        @relation(fields: [userId], references: [id], onDelete: Cascade)
  merchant             Merchant                    @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  transactions         LoyaltyTransaction[]
  qrTokens             QrToken[]
  caisseGrants         CaisseGrant[]
  walletEvents         WalletEvent[]
  googleWalletObject   GoogleWalletObject?
  rewardEntitlements   CustomerRewardEntitlement[]

  @@unique([userId, merchantId])
  @@index([merchantId])
  @@index([merchantId, createdAt])
}

model CustomerRewardEntitlement {
  id                     String                          @id @default(cuid())
  customerMembershipId   String
  merchantId             String
  originalRewardId       String?
  originalRewardName     String
  originalDescription    String?
  originalMode           LoyaltyMode
  originalUnit           String
  originalThreshold      Int
  historicalBalance      Int
  originalProgramId      String
  originalProgramVersion Int
  acquiredAt             DateTime
  expiresAt              DateTime?
  status                 CustomerRewardEntitlementStatus @default(AVAILABLE)
  redeemedAt             DateTime?
  ineligibleAt           DateTime?
  metadata               Json?
  createdAt              DateTime                        @default(now())
  updatedAt              DateTime                        @updatedAt

  membership     CustomerMembership @relation(fields: [customerMembershipId], references: [id], onDelete: Cascade)
  merchant       Merchant           @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  originalReward LoyaltyReward?     @relation(fields: [originalRewardId], references: [id], onDelete: SetNull)

  @@unique([customerMembershipId, originalRewardId, originalProgramVersion])
  @@index([merchantId, status])
  @@index([customerMembershipId, status])
}

model LoyaltyTransaction {
  id                   String                @id @default(cuid())
  customerMembershipId String
  merchantId           String
  type                 LoyaltyTxType
  status               LoyaltyTxStatus       @default(COMPLETED)
  pointsDelta          Int
  purchaseAmount       Float?
  purchaseAmountCents  Int?
  balanceBefore        Int?
  balanceAfter         Int?
  ruleApplied          String?
  idempotencyKey       String?               @unique
  reason               String?
  rewardId             String?
  relatedTxId          String?
  programVersion       Int?
  metadata             Json?
  performedByUserId    String
  createdAt            DateTime              @default(now())
  membership           CustomerMembership    @relation(fields: [customerMembershipId], references: [id], onDelete: Cascade)
  merchant             Merchant              @relation(fields: [merchantId], references: [id], onDelete: Restrict)
  performedBy          User                  @relation("PerformedBy", fields: [performedByUserId], references: [id], onDelete: Restrict)
  reward               LoyaltyReward?        @relation(fields: [rewardId], references: [id], onDelete: SetNull)
  fifeLifeLedgerEntry  FifeLifePointsLedger?

  @@index([customerMembershipId, createdAt])
  @@index([merchantId, createdAt])
  @@index([merchantId, type, createdAt])
  @@index([performedByUserId, createdAt])
}

/// QR fixe du client. `usedAt` horodate le dernier scan ; il n'empêche jamais un nouveau passage.
model QrToken {
  id                   String             @id @default(cuid())
  jti                  String             @unique
  customerMembershipId String
  merchantId           String
  expiresAt            DateTime
  usedAt               DateTime?
  createdAt            DateTime           @default(now())
  membership           CustomerMembership @relation(fields: [customerMembershipId], references: [id], onDelete: Cascade)
  merchant             Merchant           @relation(fields: [merchantId], references: [id], onDelete: Cascade)

  @@index([expiresAt])
}

/// Un grant par scan volontaire. Plusieurs grants peuvent partager le même `qrTokenId`.
model CaisseGrant {
  id                   String             @id @default(cuid())
  qrTokenId            String
  fifeLifeQrTokenId    String?
  customerMembershipId String
  merchantId           String
  actorUserId          String
  expiresAt            DateTime
  consumedAt           DateTime?
  earnCommittedAt      DateTime?
  earnTransactionId    String?
  programId            String?
  programVersion       Int?
  programMode          LoyaltyMode?
  createdAt            DateTime           @default(now())
  membership           CustomerMembership @relation(fields: [customerMembershipId], references: [id], onDelete: Cascade)
  merchant             Merchant           @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  fifeLifeQrToken      FifeLifeQrToken?   @relation(fields: [fifeLifeQrTokenId], references: [id], onDelete: SetNull)

  @@index([qrTokenId])
  @@index([actorUserId, expiresAt])
}

model AuditLog {
  id         String    @id @default(cuid())
  actorId    String?
  merchantId String?
  action     String
  metadata   Json?
  ip         String?
  userAgent  String?
  createdAt  DateTime  @default(now())
  actor      User?     @relation(fields: [actorId], references: [id], onDelete: SetNull)
  merchant   Merchant? @relation(fields: [merchantId], references: [id], onDelete: SetNull)

  @@index([merchantId, createdAt])
  @@index([actorId, createdAt])
  @@index([action, createdAt])
  @@index([merchantId, action, createdAt])
}

model MerchantCardTemplate {
  id            String                        @id @default(cuid())
  merchantId    String
  cardSlot      MerchantCardSlot              @default(VISITS)
  loyaltyMode   LoyaltyMode?
  name          String                        @default("Gabarit principal")
  backgroundUrl String?
  config        Json
  schemaVersion Int                           @default(1)
  status        CardTemplateStatus            @default(DRAFT)
  version       Int                           @default(1)
  isDefault     Boolean                       @default(false)
  publishedAt   DateTime?
  authorId      String?
  createdAt     DateTime                      @default(now())
  updatedAt     DateTime                      @updatedAt
  merchant      Merchant                      @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  versions      MerchantCardTemplateVersion[]

  @@index([merchantId, status])
  @@index([merchantId, cardSlot])
  @@index([merchantId, loyaltyMode])
}

model MerchantCardTemplateVersion {
  id            String               @id @default(cuid())
  templateId    String
  version       Int
  config        Json
  backgroundUrl String?
  authorId      String?
  createdAt     DateTime             @default(now())
  template      MerchantCardTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)

  @@unique([templateId, version])
  @@index([templateId, createdAt])
}

model MerchantSubscription {
  id                 String                @id @default(cuid())
  merchantId         String                @unique
  plan               SubscriptionPlan      @default(STARTER)
  amount             Float                 @default(0)
  currency           String                @default("EUR")
  frequency          SubscriptionFrequency @default(MONTHLY)
  status             SubscriptionStatus    @default(DRAFT)
  trialEndsAt        DateTime?
  startsAt           DateTime?
  endsAt             DateTime?
  nextBillingAt      DateTime?
  cancelledAt        DateTime?
  autoRenew          Boolean               @default(true)
  notes              String?
  /// Option Fidelo Insight (+10€/mois), activée manuellement par un super-admin.
  insightEnabled     Boolean               @default(false)
  insightEnabledAt   DateTime?
  insightRequestedAt DateTime?
  createdAt          DateTime              @default(now())
  updatedAt          DateTime              @updatedAt
  merchant           Merchant              @relation(fields: [merchantId], references: [id], onDelete: Cascade)
}

model MerchantContract {
  id           String         @id @default(cuid())
  merchantId   String
  reference    String
  contractType String         @default("subscription")
  status       ContractStatus @default(DRAFT)
  amount       Float          @default(0)
  currency     String         @default("EUR")
  startsAt     DateTime?
  endsAt       DateTime?
  documentUrl  String?
  notes        String?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  merchant     Merchant       @relation(fields: [merchantId], references: [id], onDelete: Cascade)

  @@index([merchantId, status])
}

model MerchantPayment {
  id         String        @id @default(cuid())
  merchantId String
  amount     Float
  currency   String        @default("EUR")
  status     PaymentStatus @default(PENDING)
  paidAt     DateTime?
  dueAt      DateTime?
  reference  String?
  notes      String?
  isManual   Boolean       @default(true)
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt
  merchant   Merchant      @relation(fields: [merchantId], references: [id], onDelete: Cascade)

  @@index([merchantId, status])
  @@index([paidAt])
}

model AccountDeletionRequest {
  id        String                @id @default(cuid())
  userId    String
  status    AccountDeletionStatus @default(PENDING)
  message   String?
  createdAt DateTime              @default(now())
  user      User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
}

/// Ledger des points Fidelo globaux.
model FifeLifePointsLedger {
  id        String   @id @default(cuid())
  userId    String
  delta     Int
  reason    String
  createdAt DateTime @default(now())

  user                 User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  loyaltyTransactionId String?             @unique
  loyaltyTransaction   LoyaltyTransaction? @relation(fields: [loyaltyTransactionId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
}

/// Événement de portefeuille destiné à la synchronisation légère (SSE ou polling doux).
model WalletEvent {
  id                   String          @id @default(cuid())
  userId               String
  merchantId           String?
  customerMembershipId String?
  type                 WalletEventType
  payload              Json
  createdAt            DateTime        @default(now())
  acknowledgedAt       DateTime?

  user       User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  merchant   Merchant?           @relation(fields: [merchantId], references: [id], onDelete: SetNull)
  membership CustomerMembership? @relation(fields: [customerMembershipId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([userId, acknowledgedAt])
}

/// QR global et universel Fidelo, un par utilisateur.
model FifeLifeQrToken {
  id            String    @id @default(cuid())
  userId        String    @unique
  jti           String    @unique
  createdAt     DateTime  @default(now())
  lastScannedAt DateTime?

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  caisseGrants CaisseGrant[]

  @@index([userId])
}

model GoogleWalletClass {
  id            String                 @id @default(cuid())
  kind          GoogleWalletClassKind
  merchantId    String?
  googleClassId String                 @unique
  activeProfile MerchantCardSlot       @default(GENERAL)
  configByMode  Json                   @default("{}")
  syncStatus    GoogleWalletSyncStatus @default(NEVER_SYNCED)
  lastSyncedAt  DateTime?
  lastError     String?
  createdAt     DateTime               @default(now())
  updatedAt     DateTime               @updatedAt
  merchant      Merchant?              @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  walletObjects GoogleWalletObject[]

  @@unique([kind, merchantId])
  @@index([merchantId])
  @@index([syncStatus])
}

model GoogleWalletObject {
  id                   String                 @id @default(cuid())
  userId               String
  merchantId           String?
  customerMembershipId String?                @unique
  googleObjectId       String                 @unique
  googleClassId        String
  classRecordId        String?
  syncStatus           GoogleWalletSyncStatus @default(NEVER_SYNCED)
  needsSync            Boolean                @default(true)
  lastSyncedAt         DateTime?
  lastError            String?
  createdAt            DateTime               @default(now())
  updatedAt            DateTime               @updatedAt
  user                 User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  merchant             Merchant?              @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  membership           CustomerMembership?    @relation(fields: [customerMembershipId], references: [id], onDelete: Cascade)
  classRecord          GoogleWalletClass?     @relation(fields: [classRecordId], references: [id], onDelete: SetNull)

  @@unique([userId, merchantId])
  @@index([userId])
  @@index([merchantId])
  @@index([syncStatus, needsSync])
}

// ───────────────────────── Campagnes, consentements, push, publicité ─────────────────────────

enum CampaignChannel {
  IN_APP_PUSH
  EMAIL
  SPONSORED_AD
}

enum CampaignAudienceType {
  MERCHANT_MEMBERS
  NETWORK_LOCAL
}

enum CampaignStatus {
  DRAFT
  PENDING_REVIEW
  PAYMENT_REQUIRED
  PAID
  SCHEDULED
  SENDING
  SENT
  PARTIALLY_SENT
  FAILED
  REJECTED
  CANCELLED
}

/// Quotas mensuels/Insight consommés de façon atomique (voir CampaignQuotaUsage).
enum CampaignQuotaKind {
  MEMBER_NOTIFICATION
  MEMBER_EMAIL
  NETWORK_NOTIFICATION
  NETWORK_EMAIL
  SPONSORED_DAY
}

enum CampaignPaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
  CANCELLED
}

enum CampaignDeliveryChannel {
  IN_APP
  PUSH
  EMAIL
}

enum CampaignDeliveryStatus {
  PENDING
  SENT
  DELIVERED
  FAILED
  SKIPPED
}

enum InAppNotificationKind {
  SERVICE
  MERCHANT_OFFER
  NETWORK_DEAL
}

enum AdRequestStatus {
  DRAFT
  PENDING_REVIEW
  APPROVED
  REJECTED
  SCHEDULED
  LIVE
  ENDED
  CANCELLED
}

enum AdEventType {
  IMPRESSION
  CLICK
}

enum EmailSuppressionReason {
  UNSUBSCRIBED
  BOUNCED
  COMPLAINED
  MANUAL
}

model Campaign {
  id                  String                @id @default(cuid())
  merchantId          String
  channel             CampaignChannel
  audienceType        CampaignAudienceType?
  status              CampaignStatus        @default(DRAFT)
  title               String
  body                String
  imageUrl            String?
  actionLabel         String?
  actionUrl           String?
  /// Toute programmation est interprétée et affichée en Europe/Paris.
  timezone            String                @default("Europe/Paris")
  scheduledAt         DateTime?
  sentAt              DateTime?
  estimatedRecipients Int?
  quotaKind           CampaignQuotaKind?
  /// Clé de période au format YYYY-MM (Europe/Paris) ou id de période d'abonnement — voir campaign-quota.ts.
  quotaPeriodKey      String?
  quotaConsumedAt     DateTime?
  priceCents          Int?
  requiresPayment     Boolean               @default(false)
  rejectionReason     String?
  createdBy           String
  createdAt           DateTime              @default(now())
  updatedAt           DateTime              @updatedAt

  merchant   Merchant           @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  payment    CampaignPayment?
  deliveries CampaignDelivery[]
  adRequest  AdRequest?
  ledgerEntry MarketingLedgerEntry?

  @@index([merchantId, status])
  @@index([status, scheduledAt])
  @@index([merchantId, quotaKind, quotaPeriodKey])
}

/// Ledger de consommation atomique des quotas inclus (normal/Insight), par commerce/type/période.
model CampaignQuotaUsage {
  id         String            @id @default(cuid())
  merchantId String
  kind       CampaignQuotaKind
  periodKey  String
  count      Int               @default(0)
  updatedAt  DateTime          @updatedAt

  @@unique([merchantId, kind, periodKey])
  @@index([merchantId])
}

model CampaignPayment {
  id                      String                @id @default(cuid())
  campaignId              String                @unique
  merchantId              String
  amountCents             Int
  currency                String                @default("eur")
  status                  CampaignPaymentStatus @default(PENDING)
  stripeCheckoutSessionId String?               @unique
  stripePaymentIntentId   String?               @unique
  stripeRefundId          String?
  failureReason           String?
  paidAt                  DateTime?
  refundedAt              DateTime?
  createdAt               DateTime              @default(now())
  updatedAt               DateTime              @updatedAt

  campaign Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@index([merchantId, status])
}

enum MarketingLedgerType {
  TOPUP
  DEBIT
  REFUND
}

enum MarketingLedgerStatus {
  PENDING
  PAID
  FAILED
  CANCELLED
}

/// Solde marketing prépayé par commerce (centimes entiers, jamais négatif — CHECK en base).
model MarketingBalance {
  merchantId   String   @id
  balanceCents Int      @default(0)
  updatedAt    DateTime @updatedAt

  merchant Merchant @relation(fields: [merchantId], references: [id], onDelete: Cascade)
}

/// Historique des recharges (TOPUP), débits d'envoi (DEBIT) et restitutions avant diffusion (REFUND).
/// `campaignId` unique : un envoi ne peut être débité qu'une fois. `stripeCheckoutSessionId` unique :
/// une recharge ne peut être créditée qu'une fois. `reversalOfId` unique : un débit n'est restitué qu'une fois.
model MarketingLedgerEntry {
  id                      String                @id @default(cuid())
  merchantId              String
  type                    MarketingLedgerType
  status                  MarketingLedgerStatus @default(PAID)
  /// Toujours positif ; le signe est porté par `type`.
  amountCents             Int
  balanceAfterCents       Int?
  campaignId              String?               @unique
  reversalOfId            String?               @unique
  stripeCheckoutSessionId String?               @unique
  stripePaymentIntentId   String?
  description             String
  createdAt               DateTime              @default(now())

  merchant Merchant  @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  campaign Campaign? @relation(fields: [campaignId], references: [id], onDelete: SetNull)

  @@index([merchantId, createdAt])
}

/// Idempotence des webhooks Stripe : un id d'événement Stripe n'est jamais traité deux fois.
model StripeWebhookEvent {
  id          String   @id
  type        String
  processedAt DateTime @default(now())
}

model CampaignDelivery {
  id             String                  @id @default(cuid())
  campaignId     String
  userId         String
  channel        CampaignDeliveryChannel
  status         CampaignDeliveryStatus  @default(PENDING)
  attempts       Int                     @default(0)
  lastError      String?
  /// Nouvelle tentative interdite avant cette date (délai progressif — Partie 15). Null = éligible immédiatement.
  nextAttemptAt  DateTime?
  sentAt         DateTime?
  clickedAt      DateTime?
  unsubscribedAt DateTime?
  createdAt      DateTime                @default(now())

  campaign Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@unique([campaignId, userId, channel])
  @@index([campaignId, status])
  @@index([status, nextAttemptAt])
}

model InAppNotification {
  id          String                @id @default(cuid())
  userId      String
  merchantId  String?
  campaignId  String?
  kind        InAppNotificationKind
  title       String
  body        String
  imageUrl    String?
  actionLabel String?
  actionUrl   String?
  readAt      DateTime?
  createdAt   DateTime              @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([userId, readAt])
}

/// Un abonnement Web Push par appareil (un même utilisateur peut avoir plusieurs endpoints).
model PushSubscription {
  id         String   @id @default(cuid())
  userId     String
  endpoint   String   @unique
  p256dh     String
  auth       String
  userAgent  String?
  createdAt  DateTime @default(now())
  lastSeenAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/// Journal d'audit des consentements (append-only) : date, source, version, valeur — jamais réécrit.
model ConsentEvent {
  id        String   @id @default(cuid())
  userId    String
  field     String
  value     Boolean
  source    String
  version   String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, field, createdAt])
}

model EmailSuppression {
  id        String                 @id @default(cuid())
  email     String                 @unique
  reason    EmailSuppressionReason
  createdAt DateTime               @default(now())
}

model AdRequest {
  id                String          @id @default(cuid())
  merchantId        String
  campaignId        String?         @unique
  status            AdRequestStatus @default(DRAFT)
  requestedText     String
  requestedImageUrl String?
  objective         String?
  ctaLabel          String?
  ctaUrl            String?
  startDate         DateTime
  endDate           DateTime
  finalImageUrl     String?
  rejectionReason   String?
  reviewedBy        String?
  reviewedAt        DateTime?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  merchant Merchant  @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  campaign Campaign? @relation(fields: [campaignId], references: [id])
  events   AdEvent[]

  @@index([merchantId, status])
  @@index([status, startDate, endDate])
}

model AdEvent {
  id          String      @id @default(cuid())
  adRequestId String
  type        AdEventType
  createdAt   DateTime    @default(now())

  adRequest AdRequest @relation(fields: [adRequestId], references: [id], onDelete: Cascade)

  @@index([adRequestId, type, createdAt])
}
