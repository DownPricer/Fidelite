# FifeLite — bloc additif pour le Nginx central Docker (downpricer-nginx)
#
# Où l’ajouter
# ------------
# Copier CE FICHIER SEUL vers le montage conf.d déjà utilisé par downpricer-nginx,
# en général :
#   /opt/downpricer/nginx/conf.d/fifelite.conf
#
# Ne pas modifier, renommer ni écraser les autres fichiers de ce dossier
# (downpricer, anthea, scan, etc.).
#
# Prérequis Docker
# ----------------
# Le conteneur fifelite-web doit être sur le réseau downpricer_downpricer-network
# (déjà déclaré dans deploy/docker-compose.yml via EXTERNAL_PROXY_NETWORK).
# downpricer-nginx n’a pas besoin d’être reconstruit.
#
# Tester puis recharger UNIQUEMENT Nginx
# --------------------------------------
#   docker exec downpricer-nginx nginx -t
#   docker exec downpricer-nginx nginx -s reload
#
# HTTPS (même méthode que les autres vhosts sitereadyshd.fr)
# --------------------------------------------------------
# 1. Créer les enregistrements DNS A des trois hôtes vers 51.210.179.212
# 2. Laisser d’abord les blocs listen 80 actifs (fichier tel quel)
# 3. Obtenir les certificats comme pour les autres projets, par exemple :
#
#    docker run --rm \
#      -v /opt/downpricer/nginx/ssl:/etc/letsencrypt \
#      -v /opt/downpricer/nginx/www:/var/www/certbot \
#      certbot/certbot certonly --webroot -w /var/www/certbot \
#      -d fidelite.sitereadyshd.fr \
#      -d app-fidelite.sitereadyshd.fr \
#      -d admin-fidelite.sitereadyshd.fr
#
#    Si le VPS utilise déjà un autre montage (ex. /etc/nginx/ssl/live/...),
#    recopiez exactement cette convention. N’adaptez que les trois noms FifeLite.
# 4. Décommenter les blocs 443 ci-dessous, ajuster ssl_certificate* ,
#    puis nginx -t && nginx -s reload.
#
# Sous-domaines FifeLite uniquement
#   fidelite.sitereadyshd.fr       → espace client
#   app-fidelite.sitereadyshd.fr   → commerçant / caisse
#   admin-fidelite.sitereadyshd.fr → super-admin
# Ne pas utiliser app.sitereadyshd.fr ni admin.sitereadyshd.fr.

upstream fifelite_web {
    server fifelite-web:3000;
    keepalive 8;
}

server {
    listen 80;
    server_name fidelite.sitereadyshd.fr;

    # Décommenter si Certbot webroot est monté comme sur les autres vhosts :
    # location /.well-known/acme-challenge/ { root /var/www/certbot; }

    location / {
        proxy_pass http://fifelite_web;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "";
        proxy_read_timeout 120s;
    }
}

server {
    listen 80;
    server_name app-fidelite.sitereadyshd.fr;

    location / {
        proxy_pass http://fifelite_web;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "";
        proxy_read_timeout 120s;
    }
}

server {
    listen 80;
    server_name admin-fidelite.sitereadyshd.fr;

    location / {
        proxy_pass http://fifelite_web;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "";
        proxy_read_timeout 120s;
    }
}

