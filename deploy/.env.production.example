# FifeLite — exemple de variables de production
# Copier vers /opt/fifelite/app/site/.env
#   cp deploy/.env.production.example .env
# Ne jamais committer le fichier .env réel.

# Réseau Docker externe déjà utilisé par downpricer-nginx
EXTERNAL_PROXY_NETWORK=downpricer_downpricer-network

# PostgreSQL dédié (conteneur fifelite-postgres, non exposé)
POSTGRES_USER=fifelite
POSTGRES_PASSWORD=remplacez-par-un-mot-de-passe-fort
POSTGRES_DB=fifelite

# L’URL ci-dessous est reconstruite par Compose vers fifelite-postgres.
# Conservez-la alignée avec POSTGRES_* si vous la surchargez.
DATABASE_URL=postgresql://fifelite:remplacez-par-un-mot-de-passe-fort@fifelite-postgres:5432/fifelite?schema=public

NODE_ENV=production
APP_NAME=FifeLite
PORT=3000
APP_URL=https://fidelite.sitereadyshd.fr

CUSTOMER_ORIGIN=https://fidelite.sitereadyshd.fr
APP_ORIGIN=https://app-fidelite.sitereadyshd.fr
ADMIN_ORIGIN=https://admin-fidelite.sitereadyshd.fr
EXTRA_ORIGINS=

CUSTOMER_HOST=fidelite.sitereadyshd.fr
APP_HOST=app-fidelite.sitereadyshd.fr
ADMIN_HOST=admin-fidelite.sitereadyshd.fr

QR_SECRET=remplacez-par-une-chaine-aleatoire-d-au-moins-32-caracteres
QR_TTL_SECONDS=60
SESSION_DAYS=30
SESSION_COOKIE_NAME=fifelite_session

# Seed : une seule fois après le premier déploiement, si nécessaire.
# Le seed refuse NODE_ENV=production sauf SEED_ALLOW_PRODUCTION=true
SEED_SUPERADMIN_EMAIL=
SEED_SUPERADMIN_PASSWORD=
SEED_MERCHANT_ADMIN_EMAIL=
SEED_MERCHANT_ADMIN_PASSWORD=
SEED_EMPLOYEE_EMAIL=
SEED_EMPLOYEE_PASSWORD=
SEED_CUSTOMER_EMAIL=
SEED_CUSTOMER_PASSWORD=
SEED_ALLOW_PRODUCTION=false

# Google Wallet (optionnel)
GOOGLE_WALLET_ISSUER_ID=
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=
GOOGLE_CLOUD_PROJECT_ID=
GOOGLE_WALLET_ORIGINS=https://fidelite.sitereadyshd.fr
GOOGLE_WALLET_CLASS_PREFIX=
